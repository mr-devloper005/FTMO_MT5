# FTMO MT5 Trading System - Environment Configuration Example
# Copy this file to .env and fill in your actual values
# WARNING: Never commit .env file with real credentials to version control!

# ============================================================================
# MT5 BROKER CREDENTIALS (REQUIRED)
# ============================================================================

# Your FTMO MT5 account login number (found in FTMO dashboard > Account Details)
MT5_LOGIN=<paste_your_login_number_here>

# MT5 server name (found in FTMO dashboard or MT5 > File > Login to Trade Account)
# Common FTMO servers: "FTMO-Demo", "FTMO-Server", or check your welcome email
MT5_SERVER=<paste_your_server_name_here>

# Your MT5 account password (from FTMO dashboard > Account Details)
MT5_PASSWORD=<paste_your_password_here>


# ============================================================================
# CONFIGURATION FILES
# ============================================================================

# Path to YAML configuration file for your challenge type
# Options: config/1step.yaml, config/2step.yaml, or custom path
# Default: config/default.yaml
FTMO_CONFIG_PATH=config/default.yaml

# Directory for event store (append-only audit trail)
# Default: data/events
# Should have sufficient disk space (10GB+ for long trading sessions)
FTMO_EVENT_STORE_DIR=data/events


# ============================================================================
# SYSTEM PARAMETERS
# ============================================================================

# Market data tick/sample interval in milliseconds
# Lower values = faster signal generation but higher CPU usage
# Default: 1000 (1 second)
SYSTEM_TICK_INTERVAL_MS=1000

# Health check interval in seconds
# How often system monitors component health
# Default: 5
SYSTEM_HEARTBEAT_INTERVAL_S=5

# Maximum agent restart attempts before system HALT
# If an agent crashes more than this many times, system enters HALT
# Default: 3
SYSTEM_MAX_AGENT_RESTARTS=3

# Log level: DEBUG, INFO, WARNING, ERROR
# DEBUG: Verbose output for development/troubleshooting
# INFO: Standard operational logs (recommended for production)
# WARNING: Only warning/error logs
# ERROR: Only errors
# Default: INFO
LOG_LEVEL=INFO


# ============================================================================
# OBSERVABILITY & MONITORING
# ============================================================================

# OpenTelemetry collector gRPC endpoint
# For sending distributed traces to a collector
# Examples:
#   localhost:4317              (local Jaeger)
#   localhost:4317              (local Tempo)
#   otel.company.com:4317       (remote collector)
#
# Leave empty/commented to disable tracing export
# OTEL_ENDPOINT=localhost:4317

# JSON output for structured logging (recommended for production)
# If true, all logs are JSON format for easy parsing
# If false, logs are human-readable format
LOG_FORMAT_JSON=true

# Log output directory
# If specified, logs are written to both console and file
LOG_DIR=logs

# Prometheus metrics port
# Health check server listens on this port
# Default: 8080 (configured in code)
# METRICS_PORT=8080


# ============================================================================
# CHALLENGE PARAMETERS (FTMO-Specific)
# ============================================================================

# These can also be set via environment variables like:
# FTMO_INITIAL_CAPITAL=100000
# FTMO_DAILY_LOSS_LIMIT_PCT=5
# FTMO_PROFIT_TARGET_PCT=10
#
# Or in the YAML configuration file (recommended)
# These environment variables override YAML settings if both are present

# FTMO_INITIAL_CAPITAL=100000
# FTMO_CHALLENGE_TYPE=1STEP
# FTMO_DAILY_LOSS_LIMIT_PCT=5
# FTMO_TOTAL_LOSS_LIMIT_PCT=10
# FTMO_PROFIT_TARGET_PCT=10
# FTMO_PRE_MIDNIGHT_FLATTEN_MINUTES=30
# FTMO_MAGIC=999999


# ============================================================================
# ADVANCED/OPTIONAL SETTINGS
# ============================================================================

# Database connection string (for future event store persistence)
# Currently not used, placeholder for future versions
# DATABASE_URL=postgresql://user:password@localhost/ftmo_events

# Debug mode: enables additional logging and dumps
# Default: false
DEBUG_MODE=false

# Performance profiling: captures timing data
# Default: false
ENABLE_PROFILING=false

# Email notifications for alerts (future feature)
# ALERT_EMAIL_TO=trading-alerts@company.com
# ALERT_EMAIL_FROM=ftmo-system@company.com

# SMS alerts via Twilio (future feature)
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_FROM=+1234567890
# TWILIO_PHONE_TO=+9876543210

# Slack webhook for alerts
# SLACK_WEBHOOK_CRITICAL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# SLACK_WEBHOOK_ALERTS=https://hooks.slack.com/services/YOUR/WEBHOOK/URL


# ============================================================================
# DEVELOPMENT/TESTING ONLY
# ============================================================================

# Do NOT set these in production!

# Enable mock MT5 gateway (simulates trading without real connection)
# MOCK_MT5=false

# Paper trading mode (no real money risk)
# PAPER_TRADE=false

# Replay event store instead of live trading
# REPLAY_MODE=false
# REPLAY_FROM_TIMESTAMP=2026-04-01T00:00:00+02:00


# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================

# 1. Copy this file:
#    cp .env.example .env

# 2. Fill in required credentials:
#    MT5_LOGIN, MT5_SERVER, MT5_PASSWORD

# 3. Verify configuration file exists:
#    ls -la config/1step.yaml

# 4. (Optional) Set observability endpoint:
#    OTEL_ENDPOINT=localhost:4317

# 5. Load environment and start system:
#    source .env
#    ftmo-mt5

# 6. Verify system health:
#    curl http://localhost:8080/health

# ============================================================================
# SECURITY NOTES
# ============================================================================

# - NEVER commit .env file with real credentials to git
# - Add .env to .gitignore
# - Use credential manager for sensitive data in production
# - Rotate MT5_PASSWORD regularly
# - Limit .env file permissions: chmod 600 .env
# - For VPS deployment, use environment variables from secure vault
# - For Kubernetes, use Secrets or sealed-secrets
# - For Docker, use docker secrets or environment files with 0600 permissions
#
# Production credential management examples:
#   - AWS Secrets Manager
#   - Hashicorp Vault
#   - Azure Key Vault
#   - Kubernetes Secrets
#   - SSM Parameter Store
