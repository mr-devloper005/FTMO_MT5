,22073.5,22412.8,22461.0,22669.2,22751.5,22893.2,22692.8,22843.0,23062.5,22906.8,22884.8,22896.8,23052.8,23013.2,22959.0,23035.5,23056.8,23076.5,23251.0,23224.2,23342.0,23226.2,23310.8,23377.5,23421.2,23491.2,23452.0,23480.5,23365.0,22883.8,23296.5,23132.0,23422.8,23496.2,23713.8,23637.5,23938.0,23946.5,23930.5,23804.0,23797.8,23469.5,23324.0,23219.8,23569.8,23498.2,23591.5,23628.8,23769.0,23461.8,23275.0,23448.8,23668.0,23684.0,23799.8,23874.0,23877.8,24017.8,24113.2,24309.2,24284.0,24222.5,24460.2,24568.1,25003.0,24827.2,24739.2,24629.2,24726.8,24837.8,24901.8,25017.5,25110.0,24992.0,25184.8,25039.2,25331.0,25289.2,24397.0,24922.2,24762.5,24924.5,24831.2,24986.5,25305.2,25294.8,25039.2,25254.0,25509.2,25963.8,26163.5,26262.5,25882.8,26004.0,26103.2,25575.2,25746.2,25244.2,25166.2,25714.5,25640.8,25623.8,25094.8,25094.0,24879.0,24595.8,24721.8,24131.5,24305.5,24948.2,25085.5,25302.2,25482.0,25391.2,25606.0,25657.5,25622.8,25732.0,25664.0,25699.8,25798.0,25713.5,25213.5,25093.2,25139.0,24668.8,25028.2,25132.8,25692.2,25812.2,25880.5,25863.2,25739.8,25675.2,25456.8,25385.2,25577.8,25822.0,25838.8,25687.5,25938.2,25956.8,25906.0,25631.0,25705.8,25689.0,25129.2,25471.0,25658.2,25738.2,25848.5,26073.0,26156.2,25999.2,25670.0,25850.0,25452.0,24999.2,24651.0,25163.2,25354.0,25218.2,25288.5,24768.0,24803.2,24767.8,24956.0,24858.8,25067.5,24762.8,25028.8,25382.0,25081.0,25004.8,25025.2,24755.8,25128.2,25049.5,24670.2,24991.0,24982.5,24983.5,24560.0,24394.2,24675.8,24795.5,24434.5,24364.0,24291.8,24408.2,24213.8,24367.8,23794.2,23328.5,23139.8,23915.0,24194.8,24218.0,24358.5,24371.0,25074.2,25251.5,25281.2,25543.5,25996.8,26365.5,26487.2,26825.5,26748.8,26634.8,27083.0,26934.0,27435.0,27440.5,27168.8,27325.2,27596.0,27835.8,27776.0,28136.0,28716.8,28682.2,29332.5,29424.0,29170.0,29479.2,29687.8,29231.8,29096.0,28924.2,29390.5,29447.2,29558.8,30073.5,30047.2,30307.0,30405.2,30566.2,30712.8,30633.2,30488.2,29026.5,29454.8,29117.0,28554.0,29464.8,29662.0,30559.2,29995.0,29687.5,30263.3,30653.5,29666.0,29514.2,29724.8,29368.2,30052.8,30523.5,30094.2,29556.0,29941.0,29391.5,29468.5,29937.0,30032.2,29475.8,29790.2,29693.2,29225.8,28773.2,28778.8,29316.0,29181.2,28620.8,28282.2,28190.0,27922.0,27342.0,28237.8,28404.2,28891.8,29863.5,29615.0,29488.2,29834.8,29737.0,29626.0,29853.2,30188.5,30141.8,30096.0,29586.0,29512.8,29300.5,29471.0]};

// ---------------------------------------------------------------------------
// Beat the Hold — a human-played historical trading game.
//
// The one rule this file exists to enforce: NOTHING here ever opens, closes or
// reverses a position except a click on BUY LONG / SHORT / CLOSE. The playback
// controls move the *market*; they never trade. There is no strategy in this
// file and the backtest engine is not imported.
//
// Look-ahead: `visibleBars()` is the only accessor and it stops at `cursor`.
// The decision detector reads through it too, so it can never peek forward.
// ---------------------------------------------------------------------------

const UNIT = GAME.unit;               // $/point, from the codebase instrument
const START = 100000, QTY = 1, WINDOW = 90, WARMUP = 40;

// One continuous history, rebuilt once from the flat arrays it travels in.
// A session is a slice of it; nothing about the market is curated or invented.
const ALL = GAME.t.map((t, i) => ({ t, o: GAME.o[i], h: GAME.h[i], l: GAME.l[i], c: GAME.c[i] }));

let sessionStart = 0;                 // index in ALL of the first playable bar
let STEPS = 200;                      // session length in bars, chosen at setup

// Detector calibration, measured against all four rounds: ~14-15 stops each.
const MOVE_PCT = 3.0, VOL_MULT = 2.5, COOLDOWN = 12;

const $ = (id) => document.getElementById(id);
const money = (v) => (v < 0 ? '-' : '') + '$' + Math.round(Math.abs(v)).toLocaleString();
const signed = (v) => (v > 0 ? '+' : '') + money(v);
const cls = (v) => v > 0 ? 'up' : v < 0 ? 'down' : '';

let cursor, barNo;
let side, qty, entry, realized, peak, maxDd, tradeCount;
let decisionNo, lastStopBar, flagged;
// Three separate records. A decision is not a trade: a player can stand at a
// decision point and do nothing, and that is worth recording on its own.
let trades = [];        // completed round trips
let decisions = [];     // what was done at each decision point
let equityLog = [];     // player and benchmark equity, bar by bar
let openTrade = null;   // the round trip currently in progress
let actedSinceStop = false;   // did the player trade since the last stop?

let ffTimer = null, ffSpeed = 0;

function bars() { return ALL; }
// The only accessor. It starts at the session's warmup and stops at `cursor`,
// so no drawing or calculation can reach a bar the player has not lived to.
function visibleBars() { return ALL.slice(Math.max(0, sessionStart - WARMUP), cursor + 1); }
function bar() { return bars()[cursor]; }
function price() { return bar().c; }

// --- benchmark: computed from data alone, never from the player -------------
function bhEntry() { return ALL[sessionStart].o; }
function bhAt(i) { return START + (bars()[i].c - bhEntry()) * UNIT; }
function bhDrawdown() {
  let p = -Infinity, worst = 0;
  for (let k = sessionStart; k <= cursor; k++) {
    const e = bhAt(k); p = Math.max(p, e); worst = Math.min(worst, (e - p) / p * 100);
  }
  return worst;
}

// --- account ---------------------------------------------------------------
function unrealised() {
  if (side === 'FLAT') return 0;
  return (side === 'LONG' ? price() - entry : entry - price()) * qty * UNIT;
}
function cash() { return START + realized; }
function equity() { return cash() + unrealised(); }

// ---------------------------------------------------------------------------
// Decision points — pacing only. These describe what the market did; they never
// suggest an action, and the player is free to ignore every one of them.
// ---------------------------------------------------------------------------
function decisionAt(k) {
  const b = bars();
  if (k < sessionStart + 1) return null;
  const cur = b[k], prev = b[k - 1];

  const closes = b.slice(Math.max(0, k - 20), k + 1).map(x => x.c);
  const pcloses = b.slice(Math.max(0, k - 21), k).map(x => x.c);
  const sma = closes.reduce((a, c) => a + c, 0) / closes.length;
  const psma = pcloses.reduce((a, c) => a + c, 0) / pcloses.length;
  const ranges = b.slice(Math.max(0, k - 14), k + 1).map(x => x.h - x.l);
  const atr = ranges.reduce((a, c) => a + c, 0) / ranges.length;
  const prior = b.slice(Math.max(0, k - 20), k);
  const hi = Math.max(...prior.map(x => x.h)), lo = Math.min(...prior.map(x => x.l));
  const ret = (cur.c - prev.c) / prev.c * 100;

  if (cur.c > hi) return 'Breakout — new 20-bar high';
  if (cur.c < lo) return 'Breakdown — new 20-bar low';
  if (Math.abs(ret) > MOVE_PCT) return ret > 0 ? 'Sharp rally' : 'Sharp selloff';
  if ((cur.h - cur.l) > VOL_MULT * atr) return 'Volatility expansion';
  if ((prev.c > psma) !== (cur.c > sma))
    return cur.c > sma ? 'Trend changed — back above the 20-bar average'
                       : 'Trend changed — now below the 20-bar average';

  // Position-state events fire once per position, so a profitable trade does
  // not stop the game on every subsequent bar.
  if (side !== 'FLAT') {
    const u = unrealised();
    if (u > 0.05 * START && !flagged.has('up')) { flagged.add('up'); return 'Your position has moved well in your favour'; }
    if (u < -0.03 * START && !flagged.has('dn')) { flagged.add('dn'); return 'Your position is in drawdown'; }
  }
  return null;
}

// ---------------------------------------------------------------------------
// Advancing the market. One bar, and no trading — ever.
// ---------------------------------------------------------------------------
function advanceOne() {
  if (barNo >= STEPS) return false;
  cursor++; barNo++;
  const eq = equity();
  peak = Math.max(peak, eq);
  maxDd = Math.min(maxDd, (eq - peak) / peak * 100);
  equityLog.push({ bar: barNo, date: bar().t, eq, bh: bhAt(cursor) });
  return true;
}

function nextStep() {
  stopFF();
  if (!advanceOne()) return finish();
  const why = barNo - lastStopBar >= COOLDOWN ? decisionAt(cursor) : null;
  if (why) markDecision(why); else clearAlert();
  say('Advanced <b>one bar</b>. Position unchanged: <b>' + posText() + '</b>.');
  render();
  if (barNo >= STEPS) finish();
}

function nextDecision() {
  stopFF();
  let moved = 0;
  while (barNo < STEPS) {
    if (!advanceOne()) break;
    moved++;
    if (barNo - lastStopBar >= COOLDOWN) {
      const why = decisionAt(cursor);
      if (why) {
        markDecision(why);
        say('Skipped <b>' + moved + ' bars</b> to the next decision point.<br>Position unchanged: <b>' + posText() + '</b>.');
        render();
        return;
      }
    }
  }
  render();
  if (barNo >= STEPS) finish();
  else say('Advanced ' + moved + ' bars — no further decision point.');
}

// Fast forward moves the market on a timer. It cannot trade, and it stops the
// moment a decision point appears so it can never run past one.
function startFF(speed) {
  stopFF();
  ffSpeed = speed;
  paintSpeeds();
  ffTimer = setInterval(() => {
    if (barNo >= STEPS) { stopFF(); finish(); return; }
    advanceOne();
    if (barNo - lastStopBar >= COOLDOWN) {
      const why = decisionAt(cursor);
      if (why) {
        markDecision(why);
        stopFF();
        say('<b>Paused automatically.</b> Position unchanged: <b>' + posText() + '</b>.');
      }
    }
    render();
    if (barNo >= STEPS) { stopFF(); finish(); }
  }, Math.round(420 / speed));
}
function stopFF() {
  if (ffTimer) clearInterval(ffTimer);
  ffTimer = null; ffSpeed = 0; paintSpeeds();
}
function paintSpeeds() {
  document.querySelectorAll('.speeds button[data-sp]').forEach(b =>
    b.className = (+b.dataset.sp === ffSpeed ? 'on' : ''));
}

// Every entry is stamped at the bar it actually happened on: a trade at the
// bar it was placed, a HOLD at the decision point that went unanswered.
function noteDecision(action, before, after, why) {
  decisions.push({ n: decisions.length + 1, bar: barNo, date: bar().t,
                   price: price(), action, before, after, why: why || '' });
  actedSinceStop = true;
}

function markDecision(why) {
  // A decision point the player let pass without acting is a HOLD, and worth
  // recording — choosing to do nothing is a decision.
  if (!actedSinceStop && decisions.length)
    noteDecision('HOLD', posText(), posText(), why);
  actedSinceStop = false;
  lastStopBar = barNo;
  decisionNo++;
  $('alert').textContent = 'DECISION POINT · ' + why;
  $('alert').className = 'alert show';
}
function clearAlert() { $('alert').className = 'alert'; }

// ---------------------------------------------------------------------------
// Trading — reachable only from the three buttons below.
// ---------------------------------------------------------------------------
function posText() { return side === 'FLAT' ? 'FLAT' : side + ' ' + qty; }

function openPos(dir) {
  if (side !== 'FLAT') return;
  side = dir; qty = QTY; entry = price(); flagged = new Set();
  openTrade = { dir, entryBar: barNo, entryDate: bar().t, entryPrice: entry,
                entryCursor: cursor, qty: QTY, equityBefore: equity() };
  noteDecision(dir === 'LONG' ? 'BUY LONG' : 'SHORT', 'FLAT', posText());
  say('<b>' + (dir === 'LONG' ? 'Bought' : 'Shorted') + ' 1 NQ @ ' +
      Math.round(entry).toLocaleString() + '</b>. Now move the market.');
  clearAlert(); render();
}

function closePos(reason) {
  if (side === 'FLAT') return;
  const pnl = unrealised();
  const before = equity();
  realized += pnl; tradeCount++;
  const t = openTrade;
  trades.push({
    n: trades.length + 1, dir: t.dir, qty: t.qty,
    entryBar: t.entryBar, entryDate: t.entryDate, entryPrice: t.entryPrice,
    entryCursor: t.entryCursor,
    exitBar: barNo, exitDate: bar().t, exitPrice: price(), exitCursor: cursor,
    heldBars: barNo - t.entryBar, pnl, win: pnl >= 0,
    equityBefore: t.equityBefore, equityAfter: before - unrealised() + pnl,
    reason: reason || 'closed by you',
  });
  const was = side;
  const wasPos = was + ' ' + t.qty;
  side = 'FLAT'; qty = 0; entry = 0; openTrade = null; flagged = new Set();
  noteDecision('CLOSE', wasPos, 'FLAT');
  say('<b>Closed ' + was + ' @ ' + Math.round(price()).toLocaleString() +
      ' · ' + signed(pnl) + '</b>');
  clearAlert(); render();
}

// ---------------------------------------------------------------------------
// Rendering
// ---------------------------------------------------------------------------
function say(html) { $('feed').innerHTML = html; }

function render() {
  const eq = equity(), bh = bhAt(cursor), edge = eq - bh;
  $('stepper').textContent = 'BAR ' + barNo + ' / ' + STEPS;
  $('mDate').textContent = bar().t;
  $('mPrice').textContent = Math.round(price()).toLocaleString();
  $('mDec').textContent = decisionNo;

  $('aCash').textContent = money(cash());
  $('aPos').textContent = posText();
  $('aPos').className = side === 'LONG' ? 'up' : side === 'SHORT' ? 'down' : 'flat';
  $('aEntry').textContent = side === 'FLAT' ? '—' : Math.round(entry).toLocaleString();
  $('aUnreal').textContent = side === 'FLAT' ? '—' : signed(unrealised());
  $('aUnreal').className = side === 'FLAT' ? '' : cls(unrealised());
  $('aReal').textContent = signed(realized);
  $('aReal').className = cls(realized);
  $('aEquity').textContent = money(eq);
  $('aEquity').className = 'big ' + cls(eq - START);
  $('aDd').textContent = maxDd.toFixed(1) + '%';
  $('aDd').className = maxDd < 0 ? 'down' : '';
  $('aTrades').textContent = tradeCount;

  $('bEquity').textContent = money(bh);
  $('bEquity').className = cls(bh - START);
  $('bEdge').textContent = signed(edge);
  $('bEdge').className = 'big ' + cls(edge);

  $('tag').textContent = posText();
  $('tag').className = 'tag ' + side.toLowerCase();

  $('bBuy').disabled = side !== 'FLAT';
  $('bShort').disabled = side !== 'FLAT';
  $('bClose').disabled = side === 'FLAT';
  $('bClose').textContent = side === 'FLAT' ? 'CLOSE' : 'CLOSE ' + side;

  // Where in history this session sits, and how far through it we are.
  // Start date and how far in — but not the end date. Naming the last day of
  // the session tells anyone who knows the period what is coming.
  $('chips').innerHTML =
    '<span class="chip on">started ' + ALL[sessionStart].t + '</span>' +
    '<span class="chip">today ' + bar().t + '</span>' +
    '<span class="chip">day ' + barNo + ' of ' + STEPS + '</span>' +
    '<span class="blurb">real NQ futures history · nothing ahead of ' + bar().t + ' is visible</span>';

  draw();
}

let geom = null;

function draw() {
  const cv = $('c'), ctx = cv.getContext('2d');
  const rect = cv.getBoundingClientRect();
  const W = cv.width = Math.max(360, Math.floor(rect.width || 800));
  const H = cv.height = 392;
  ctx.fillStyle = '#0E1420'; ctx.fillRect(0, 0, W, H);

  const seen = visibleBars();
  const shown = seen.slice(Math.max(0, seen.length - WINDOW));
  if (!shown.length) return;

  const lo = Math.min(...shown.map(b => b.l)), hi = Math.max(...shown.map(b => b.h));
  const pad = (hi - lo) * .08 || 1, top = hi + pad, bot = lo - pad;
  const L = 8, R = W - 62, cw = Math.max(2, (R - L) / shown.length);
  const X = (k) => L + k * cw + cw / 2;
  const Y = (p) => 16 + (1 - (p - bot) / (top - bot)) * (H - 44);

  ctx.strokeStyle = 'rgba(31,42,61,.85)'; ctx.lineWidth = 1;
  ctx.font = '10px ui-monospace, monospace'; ctx.fillStyle = '#8A93A6';
  for (let g = 0; g <= 4; g++) {
    const p = bot + (top - bot) * (g / 4), y = Y(p);
    ctx.beginPath(); ctx.moveTo(L, y); ctx.lineTo(R, y); ctx.stroke();
    ctx.fillText(Math.round(p).toLocaleString(), R + 6, y + 3);
  }

  shown.forEach((b, k) => {
    const colour = b.c >= b.o ? '#3FD07A' : '#F2564B';
    ctx.strokeStyle = colour; ctx.fillStyle = colour; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(X(k), Y(b.h)); ctx.lineTo(X(k), Y(b.l)); ctx.stroke();
    ctx.fillRect(X(k) - cw * .34, Y(Math.max(b.o, b.c)),
                 Math.max(1.5, cw * .68), Math.max(1, Math.abs(Y(b.o) - Y(b.c))));
  });

  if (side !== 'FLAT') {
    ctx.strokeStyle = side === 'LONG' ? 'rgba(63,208,122,.75)' : 'rgba(242,86,75,.75)';
    ctx.setLineDash([5, 4]); ctx.lineWidth = 1.2;
    ctx.beginPath(); ctx.moveTo(L, Y(entry)); ctx.lineTo(R, Y(entry)); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = side === 'LONG' ? '#3FD07A' : '#F2564B';
    ctx.fillText('entry ' + Math.round(entry).toLocaleString(), L + 4, Y(entry) - 5);
  }

  const k = shown.length - 1;
  ctx.strokeStyle = '#F0A82E'; ctx.setLineDash([2, 3]); ctx.lineWidth = 1;
  ctx.beginPath(); ctx.moveTo(X(k), 16); ctx.lineTo(X(k), H - 28); ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle = '#F0A82E';
  ctx.fillText(shown[k].t, Math.min(X(k) - 30, R - 66), H - 10);

  geom = { shown, X, Y, L, R, cw, H };
}

// --- chart inspection: reads visible candles, never advances anything -------
function hoverChart(e) {
  if (!geom) return;
  const cv = $('c'), rect = cv.getBoundingClientRect();
  if (!rect.width) return;
  const x = (e.clientX - rect.left) * (cv.width / rect.width);
  let k = Math.round((x - geom.L - geom.cw / 2) / geom.cw);
  k = Math.min(geom.shown.length - 1, Math.max(0, k));
  const b = geom.shown[k];
  if (!b) return;

  draw();
  const ctx = cv.getContext('2d');
  ctx.strokeStyle = 'rgba(240,168,46,.5)'; ctx.setLineDash([3, 3]); ctx.lineWidth = 1;
  ctx.beginPath(); ctx.moveTo(geom.X(k), 16); ctx.lineTo(geom.X(k), geom.H - 28); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(geom.L, geom.Y(b.c)); ctx.lineTo(geom.R, geom.Y(b.c)); ctx.stroke();
  ctx.setLineDash([]);

  const n = (v) => v.toLocaleString(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  const chg = b.c - b.o, pct = chg / b.o * 100;
  const tip = $('ohlc');
  tip.innerHTML = '<div class="d">' + b.t + '</div>' +
    '<span>O</span> ' + n(b.o) + '  <span>H</span> ' + n(b.h) + '<br>' +
    '<span>L</span> ' + n(b.l) + '  <span>C</span> ' + n(b.c) + '<br>' +
    '<span style="color:' + (chg >= 0 ? '#3FD07A' : '#F2564B') + '">' +
    (chg >= 0 ? '+' : '') + n(chg) + ' (' + (pct >= 0 ? '+' : '') + pct.toFixed(2) + '%)</span>' +
    (side !== 'FLAT' ? '<br><span>from entry</span> ' +
      signed((side === 'LONG' ? b.c - entry : entry - b.c) * qty * UNIT) : '');
  tip.className = 'ohlc show';
  tip.style.left = geom.X(k) > cv.width / 2 ? '12px' : Math.min(geom.X(k), cv.width - 190) + 'px';
}
function hoverOff() { $('ohlc').className = 'ohlc'; draw(); }

// ---------------------------------------------------------------------------
// Journal — trades, decisions and the statistics that follow from them.
// Everything here is a record of what already happened; nothing reads a bar
// beyond `cursor`, so opening the journal mid-round cannot leak the future.
// ---------------------------------------------------------------------------

function stats() {
  const wins = trades.filter(t => t.pnl > 0), losses = trades.filter(t => t.pnl <= 0);
  const gross = wins.reduce((a, t) => a + t.pnl, 0);
  const loss = losses.reduce((a, t) => a + t.pnl, 0);
  return {
    total: trades.length, wins: wins.length, losses: losses.length,
    winRate: trades.length ? wins.length / trades.length * 100 : 0,
    gross, loss, net: gross + loss,
    avg: trades.length ? (gross + loss) / trades.length : 0,
    best: trades.length ? Math.max(...trades.map(t => t.pnl)) : 0,
    worst: trades.length ? Math.min(...trades.map(t => t.pnl)) : 0,
    avgHold: trades.length ? trades.reduce((a, t) => a + t.heldBars, 0) / trades.length : 0,
  };
}

function statGrid() {
  const s = stats();
  const cell = (k, v, c) => '<div class="sc"><div class="k">' + k + '</div>' +
                            '<div class="v ' + (c || '') + '">' + v + '</div></div>';
  return '<div class="scg">' +
    cell('Total trades', s.total) +
    cell('Winning', s.wins, s.wins ? 'up' : '') +
    cell('Losing', s.losses, s.losses ? 'down' : '') +
    cell('Win rate', s.winRate.toFixed(1) + '%') +
    cell('Gross profit', money(s.gross), 'up') +
    cell('Gross loss', money(s.loss), 'down') +
    cell('Net P&L', signed(s.net), cls(s.net)) +
    cell('Average trade', signed(s.avg), cls(s.avg)) +
    cell('Largest winner', signed(s.best), 'up') +
    cell('Largest loser', signed(s.worst), 'down') +
    cell('Avg hold', s.avgHold.toFixed(1) + ' bars') +
    cell('Equity', money(equity()), cls(equity() - START)) +
    cell('Max drawdown', maxDd.toFixed(1) + '%', maxDd < 0 ? 'down' : '') +
    '</div>';
}

function tradeRows() {
  if (!trades.length) return '<tr><td colspan="9">No completed trades yet.</td></tr>';
  return trades.map(t =>
    '<tr class="clickable" data-trade="' + t.n + '">' +
    '<td>#' + t.n + '</td>' +
    '<td class="' + (t.dir === 'LONG' ? 'up' : 'down') + '">' + t.dir + '</td>' +
    '<td>' + t.qty + '</td>' +
    '<td>' + t.entryBar + ' · ' + Math.round(t.entryPrice).toLocaleString() + '</td>' +
    '<td>' + t.exitBar + ' · ' + Math.round(t.exitPrice).toLocaleString() + '</td>' +
    '<td>' + t.heldBars + ' bars</td>' +
    '<td>' + money(t.equityBefore) + '</td>' +
    '<td>' + money(t.equityAfter) + '</td>' +
    '<td class="' + (t.win ? 'up' : 'down') + '"><b>' + signed(t.pnl) + '</b> ' +
      (t.win ? 'WIN' : 'LOSS') + '</td></tr>').join('');
}

function decisionRows() {
  if (!decisions.length) return '<tr><td colspan="6">No decision points reached yet.</td></tr>';
  return decisions.map(d =>
    '<tr><td>#' + d.n + '</td><td>bar ' + d.bar + '</td><td>' + d.date + '</td>' +
    '<td>' + Math.round(d.price).toLocaleString() + '</td>' +
    '<td><b class="' + (d.action === 'HOLD' ? 'flat' : 'amber') + '">' + d.action + '</b></td>' +
    '<td>' + d.before + ' → ' + d.after + '</td></tr>').join('');
}

let journalTab = 'trades';

function openJournal(tab) {
  journalTab = tab || journalTab;
  const tabBtn = (id, label) => '<button class="tb ' + (journalTab === id ? 'on' : '') +
    '" data-tab="' + id + '">' + label + '</button>';
  const body = journalTab === 'trades'
    ? statGrid() + '<div class="log"><table><tr><th>#</th><th>Side</th><th>Qty</th>' +
      '<th>Entry</th><th>Exit</th><th>Held</th><th>Equity before</th>' +
      '<th>Equity after</th><th>Result</th></tr>' + tradeRows() + '</table></div>' +
      (trades.length ? '<div class="hintline">Click a trade to see it on the chart.</div>' : '')
    : '<div class="log"><table><tr><th>#</th><th>Bar</th><th>Date</th><th>Price</th>' +
      '<th>Action</th><th>Position</th></tr>' + decisionRows() + '</table></div>';

  $('over').className = 'over show';
  $('over').innerHTML =
    '<h2 style="color:#F0A82E">TRADING JOURNAL</h2>' +
    '<div class="when">' + ALL[sessionStart].t + ' · bar ' + barNo + ' / ' + STEPS +
      ' · only what has already happened</div>' +
    '<div class="tabs">' + tabBtn('trades', 'TRADES (' + trades.length + ')') +
      tabBtn('decisions', 'DECISIONS (' + decisions.length + ')') + '</div>' +
    body +
    '<div class="btns"><button id="closeJ">' +
      (barNo >= STEPS ? 'BACK TO RESULTS' : 'RESUME ROUND') + '</button></div>';

  $('over').querySelectorAll('.tb').forEach(b =>
    b.onclick = () => openJournal(b.dataset.tab));
  $('over').querySelectorAll('[data-trade]').forEach(tr =>
    tr.onclick = () => showTrade(+tr.dataset.trade));
  $('closeJ').onclick = () => (barNo >= STEPS ? showSummary() : closeOverlay());
}

function closeOverlay() { $('over').className = 'over'; render(); }

// One trade, drawn on its own slice of the chart with entry and exit marked.
function showTrade(n) {
  const t = trades.find(x => x.n === n);
  if (!t) return;
  $('over').innerHTML =
    '<h2 style="color:' + (t.win ? '#3FD07A' : '#F2564B') + '">TRADE #' + t.n + ' · ' +
      t.dir + (t.win ? ' · WIN' : ' · LOSS') + '</h2>' +
    '<div class="when">' + t.entryDate + ' → ' + t.exitDate + ' · held ' + t.heldBars + ' bars</div>' +
    '<div class="tradechart"><canvas id="tc" width="620" height="220"></canvas></div>' +
    '<table>' +
      '<tr><td>Direction</td><td class="' + (t.dir === 'LONG' ? 'up' : 'down') + '">' + t.dir + ' ' + t.qty + '</td></tr>' +
      '<tr><td>Entry</td><td>bar ' + t.entryBar + ' · ' + t.entryDate + ' · ' + Math.round(t.entryPrice).toLocaleString() + '</td></tr>' +
      '<tr><td>Exit</td><td>bar ' + t.exitBar + ' · ' + t.exitDate + ' · ' + Math.round(t.exitPrice).toLocaleString() + '</td></tr>' +
      '<tr><td>Holding period</td><td>' + t.heldBars + ' bars</td></tr>' +
      '<tr><td>Price move</td><td>' + (t.exitPrice - t.entryPrice >= 0 ? '+' : '') +
        (t.exitPrice - t.entryPrice).toFixed(1) + ' pts</td></tr>' +
      '<tr><td>Realised P&L</td><td class="' + (t.win ? 'up' : 'down') + '"><b>' + signed(t.pnl) + '</b></td></tr>' +
      '<tr><td>Equity before</td><td>' + money(t.equityBefore) + '</td></tr>' +
      '<tr><td>Equity after</td><td>' + money(t.equityAfter) + '</td></tr>' +
      '<tr><td>Closed</td><td>' + t.reason + '</td></tr>' +
    '</table>' +
    '<div class="btns"><button id="backJ">BACK TO JOURNAL</button></div>';
  $('backJ').onclick = () => openJournal('trades');
  drawTradeChart(t);
}

function drawTradeChart(t) {
  const cv = $('tc'); if (!cv) return;
  const ctx = cv.getContext('2d'), W = cv.width, H = cv.height;
  ctx.fillStyle = '#0E1420'; ctx.fillRect(0, 0, W, H);

  const pad = 6;
  const from = Math.max(0, t.entryCursor - pad);
  const to = Math.min(cursor, t.exitCursor + pad);       // never past the present
  const slice = bars().slice(from, to + 1);
  if (slice.length < 2) return;

  const lo = Math.min(...slice.map(b => b.l)), hi = Math.max(...slice.map(b => b.h));
  const m = (hi - lo) * .1 || 1, top = hi + m, bot = lo - m;
  const L = 8, R = W - 58, cw = Math.max(3, (R - L) / slice.length);
  const X = (k) => L + k * cw + cw / 2;
  const Y = (p) => 14 + (1 - (p - bot) / (top - bot)) * (H - 34);

  ctx.font = '10px ui-monospace, monospace';
  ctx.strokeStyle = 'rgba(31,42,61,.85)'; ctx.fillStyle = '#8A93A6';
  for (let g = 0; g <= 3; g++) {
    const p = bot + (top - bot) * (g / 3), y = Y(p);
    ctx.beginPath(); ctx.moveTo(L, y); ctx.lineTo(R, y); ctx.stroke();
    ctx.fillText(Math.round(p).toLocaleString(), R + 5, y + 3);
  }

  slice.forEach((b, k) => {
    const c = b.c >= b.o ? '#3FD07A' : '#F2564B';
    ctx.strokeStyle = c; ctx.fillStyle = c; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(X(k), Y(b.h)); ctx.lineTo(X(k), Y(b.l)); ctx.stroke();
    ctx.fillRect(X(k) - cw * .32, Y(Math.max(b.o, b.c)),
                 Math.max(1.5, cw * .64), Math.max(1, Math.abs(Y(b.o) - Y(b.c))));
  });

  const ek = t.entryCursor - from, xk = t.exitCursor - from;
  ctx.strokeStyle = 'rgba(240,168,46,.6)'; ctx.setLineDash([4, 3]); ctx.lineWidth = 1.2;
  ctx.beginPath(); ctx.moveTo(X(ek), Y(t.entryPrice)); ctx.lineTo(X(xk), Y(t.exitPrice)); ctx.stroke();
  ctx.setLineDash([]);

  const mark = (k, p, colour, up, label) => {
    ctx.fillStyle = colour;
    ctx.beginPath();
    if (up) { ctx.moveTo(X(k), Y(p) - 9); ctx.lineTo(X(k) - 6, Y(p) + 1); ctx.lineTo(X(k) + 6, Y(p) + 1); }
    else { ctx.moveTo(X(k), Y(p) + 9); ctx.lineTo(X(k) - 6, Y(p) - 1); ctx.lineTo(X(k) + 6, Y(p) - 1); }
    ctx.closePath(); ctx.fill();
    ctx.fillText(label, Math.min(X(k) - 12, R - 40), up ? Y(p) - 13 : Y(p) + 20);
  };
  mark(ek, t.entryPrice, t.dir === 'LONG' ? '#3FD07A' : '#F2564B', t.dir === 'LONG', 'ENTRY');
  mark(xk, t.exitPrice, t.win ? '#4C8DFF' : '#F0A82E', t.dir !== 'LONG', 'EXIT');
}

// ---------------------------------------------------------------------------
// Round lifecycle and results
// ---------------------------------------------------------------------------
function startSession(startIdx, length) {
  stopFF();
  sessionStart = Math.max(WARMUP, Math.min(startIdx, ALL.length - length - 1));
  STEPS = length;
  cursor = sessionStart; barNo = 1;
  side = 'FLAT'; qty = 0; entry = 0;
  realized = 0; peak = START; maxDd = 0; tradeCount = 0;
  decisionNo = 1; lastStopBar = 1; flagged = new Set();
  trades = []; decisions = []; equityLog = []; openTrade = null;
  actedSinceStop = true;
  equityLog.push({ bar: barNo, date: bar().t, eq: START, bh: bhAt(cursor) });
  $('setup').innerHTML = '';
  $('over').className = 'over'; clearAlert();
  say('It is <b>' + bar().t + '</b>. You have $100,000 and ' + STEPS +
      ' trading days. Read the chart and decide.');
  render();
}

// --- setup: choose a real historical moment -------------------------------
function showSetup() {
  stopFF();
  const first = ALL[WARMUP].t, lastIdx = ALL.length - 201;
  const last = ALL[lastIdx].t;
  const years = [];
  for (let y = 2005; y <= +ALL[lastIdx].t.slice(0, 4); y += 2) years.push(y);

  $('over').className = 'over show';
  $('over').innerHTML =
    '<div class="setupbox">' +
    '<h2 style="color:#F0A82E">PICK A MOMENT IN HISTORY</h2>' +
    '<p>Real NQ futures daily bars, ' + ALL[0].t + ' to ' + ALL[ALL.length - 1].t +
    '. Choose where to stand. You will see the market only as it was known on that ' +
    'day, and move forward one bar at a time.</p>' +
    '<div class="field"><label>Start date</label>' +
      '<input type="date" id="sDate" min="' + first + '" max="' + last + '" value="2015-01-05"></div>' +
    '<div class="field"><label>Session length</label>' +
      '<select id="sLen">' +
        '<option value="100">100 trading days (~5 months)</option>' +
        '<option value="200" selected>200 trading days (~10 months)</option>' +
        '<option value="400">400 trading days (~19 months)</option>' +
      '</select></div>' +
    '<div class="years">' + years.map(y =>
      '<button data-year="' + y + '">' + y + '</button>').join('') + '</div>' +
    '<div class="btns"><button id="sGo">START TRADING</button>' +
    '<button class="ghost" id="sRandom">RANDOM DATE</button></div>' +
    '</div>';

  const lenOf = () => +$('sLen').value;
  const idxFor = (date) => {
    let i = ALL.findIndex(b => b.t >= date);
    if (i < 0) i = ALL.length - lenOf() - 1;
    return i;
  };
  $('sGo').onclick = () => startSession(idxFor($('sDate').value), lenOf());
  $('sRandom').onclick = () => {
    const lo = WARMUP, hi = ALL.length - lenOf() - 1;
    startSession(lo + Math.floor(Math.random() * (hi - lo)), lenOf());
  };
  $('over').querySelectorAll('[data-year]').forEach(b =>
    b.onclick = () => { $('sDate').value = b.dataset.year + '-01-05'; });
}

function finish() {
  stopFF();
  if (side !== 'FLAT') closePos('end of round');

  const eq = equity(), bh = bhAt(cursor), edge = eq - bh, bhDd = bhDrawdown();
  const st = stats();
  const beat = edge > 0;
  const pct = (v) => ((v - START) / START * 100).toFixed(1) + '%';

  const line = (k, v, c) => '<tr><td>' + k + '</td><td class="' + (c || '') + '">' + v + '</td></tr>';

  $('over').className = 'over show';
  $('over').innerHTML =
    '<h2 style="color:' + (beat ? '#3FD07A' : '#F2564B') + '">' +
      (beat ? 'YOU BEAT BUY &amp; HOLD' : 'BUY &amp; HOLD BEAT YOU') + '</h2>' +
    '<div class="when">' + ALL[sessionStart].t + ' → ' + bar().t + ' · ' + STEPS +
      ' trading days · ' + decisions.length + ' decisions · ' + trades.length + ' trades</div>' +

    '<div class="equitychart"><canvas id="ec" width="640" height="180"></canvas>' +
    '<div class="eclegend"><span class="k1">■</span> You <span class="k2">■</span> Buy &amp; hold</div></div>' +

    '<div class="cols"><table>' +
      '<tr><th>You</th><th></th></tr>' +
      line('Starting capital', money(START)) +
      line('Final equity', money(eq), cls(eq - START)) +
      line('Total return', pct(eq), cls(eq - START)) +
      line('Net P&L', signed(realized), cls(realized)) +
      line('Total trades', st.total) +
      line('Win rate', st.winRate.toFixed(1) + '%') +
      line('Gross profit', money(st.gross), 'up') +
      line('Gross loss', money(st.loss), 'down') +
      line('Average trade', signed(st.avg), cls(st.avg)) +
      line('Largest winner', signed(st.best), 'up') +
      line('Largest loser', signed(st.worst), 'down') +
      line('Max drawdown', maxDd.toFixed(1) + '%', 'down') +
    '</table><table>' +
      '<tr><th>Buy &amp; hold</th><th></th></tr>' +
      line('Final equity', money(bh), cls(bh - START)) +
      line('Total return', pct(bh), cls(bh - START)) +
      line('Max drawdown', bhDd.toFixed(1) + '%', 'down') +
      '<tr><th>Comparison</th><th></th></tr>' +
      line('Equity difference', signed(edge), cls(edge)) +
      line('Return difference', ((eq - bh) / START * 100 >= 0 ? '+' : '') +
           ((eq - bh) / START * 100).toFixed(1) + '%', cls(edge)) +
      line('Drawdown difference', (maxDd - bhDd >= 0 ? '+' : '') +
           (maxDd - bhDd).toFixed(1) + '%', maxDd - bhDd >= 0 ? 'up' : 'down') +
      line('Verdict', beat ? 'ahead of the hold' : 'behind the hold', beat ? 'up' : 'down') +
    '</table></div>' +

    '<div class="btns"><button id="go">NEW SESSION</button>' +
    '<button class="ghost" id="viewLog">TRADING JOURNAL</button></div>';

  lastSummary = $('over').innerHTML;
  $('go').onclick = showSetup;
  $('viewLog').onclick = () => openJournal('trades');
  drawEquityChart();
  $('go').focus();
}

// Player equity against the benchmark, over the whole session.
function drawEquityChart() {
  const cv = $('ec'); if (!cv || equityLog.length < 2) return;
  const ctx = cv.getContext('2d'), W = cv.width, H = cv.height;
  ctx.fillStyle = '#0E1420'; ctx.fillRect(0, 0, W, H);

  const all = equityLog.flatMap(p => [p.eq, p.bh]);
  const lo = Math.min(...all), hi = Math.max(...all);
  const m = (hi - lo) * .08 || 1, top = hi + m, bot = lo - m;
  const L = 8, R = W - 62;
  const X = (i) => L + (i / (equityLog.length - 1)) * (R - L);
  const Y = (v) => 12 + (1 - (v - bot) / (top - bot)) * (H - 30);

  ctx.font = '10px ui-monospace, monospace';
  ctx.strokeStyle = 'rgba(31,42,61,.85)'; ctx.fillStyle = '#8A93A6';
  for (let g = 0; g <= 3; g++) {
    const v = bot + (top - bot) * (g / 3), y = Y(v);
    ctx.beginPath(); ctx.moveTo(L, y); ctx.lineTo(R, y); ctx.stroke();
    ctx.fillText(Math.round(v / 1000) + 'k', R + 6, y + 3);
  }
  ctx.strokeStyle = 'rgba(232,228,217,.25)'; ctx.setLineDash([3, 3]);
  ctx.beginPath(); ctx.moveTo(L, Y(START)); ctx.lineTo(R, Y(START)); ctx.stroke();
  ctx.setLineDash([]);

  const plot = (key, colour, width) => {
    ctx.beginPath();
    equityLog.forEach((p, i) => i ? ctx.lineTo(X(i), Y(p[key])) : ctx.moveTo(X(i), Y(p[key])));
    ctx.strokeStyle = colour; ctx.lineWidth = width; ctx.stroke();
  };
  plot('bh', 'rgba(232,228,217,.45)', 1.3);
  plot('eq', equityLog[equityLog.length - 1].eq >= START ? '#3FD07A' : '#F2564B', 2);
}

function showSummary() {
  $('over').innerHTML = lastSummary;
  $('go').onclick = showSetup;
  $('viewLog').onclick = () => openJournal('trades');
}

// ---------------------------------------------------------------------------
// Wiring
// ---------------------------------------------------------------------------
$('bBuy').onclick = () => openPos('LONG');
$('bShort').onclick = () => openPos('SHORT');
$('bClose').onclick = () => closePos();
$('bStep').onclick = nextStep;
$('bDec').onclick = nextDecision;
$('bPause').onclick = stopFF;
$('bJournal').onclick = () => { stopFF(); openJournal('trades'); };
document.querySelectorAll('.speeds button[data-sp]').forEach(b =>
  b.onclick = () => startFF(+b.dataset.sp));
$('c').addEventListener('mousemove', hoverChart);
$('c').addEventListener('mouseleave', hoverOff);
addEventListener('resize', draw);
addEventListener('keydown', (e) => {
  if ($('over').className.includes('show')) return;
  const k = e.key.toLowerCase();
  if (k === 'b') openPos('LONG');
  if (k === 's') openPos('SHORT');
  if (k === 'c') closePos();
  if (k === 'n') nextStep();
  if (e.code === 'Space') { e.preventDefault(); nextDecision(); }
  if (k === 'p') stopFF();
  if (k === 'j') { stopFF(); openJournal('trades'); }
});

showSetup();
</script>
