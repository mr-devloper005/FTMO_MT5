<title>Beat the Hold</title>
<style>
  :root{
    --void:#080B12; --panel:#0E1420; --panel2:#131B2A; --edge:#1F2A3D;
    --amber:#F0A82E; --amber-dim:#8A6420; --ink:#E8E4D9; --ink-dim:#8A93A6;
    --up:#3FD07A; --down:#F2564B; --flat:#5A6B85; --blue:#4C8DFF;
  }
  *{box-sizing:border-box}
  html,body{margin:0;min-height:100%}
  body{
    background:var(--void); color:var(--ink); padding:14px;
    font-family:ui-monospace,"SF Mono","JetBrains Mono",Menlo,Consolas,monospace;
    background-image:repeating-linear-gradient(0deg,rgba(240,168,46,.03) 0 1px,transparent 1px 3px);
  }
  .shell{max-width:1240px;margin:0 auto}
  .top{display:flex;align-items:baseline;gap:14px;margin-bottom:10px;flex-wrap:wrap}
  h1{margin:0;font-size:18px;letter-spacing:.22em;color:var(--amber);font-weight:600}
  .sub{font-size:11px;color:var(--ink-dim);letter-spacing:.1em}
  .back{margin-left:auto;font-size:11px;letter-spacing:.1em;color:var(--ink-dim);
        text-decoration:none;border:1px solid var(--edge);border-radius:6px;padding:5px 11px}
  .back:hover{color:var(--amber);border-color:var(--amber-dim)}
  .chips{display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap;align-items:center}
  .chip{font-size:10px;letter-spacing:.1em;padding:4px 9px;border-radius:20px;
        border:1px solid var(--edge);color:var(--ink-dim)}
  .chip.on{border-color:var(--amber);color:var(--amber)}
  .chip.done{border-color:rgba(63,208,122,.4);color:var(--up)}
  .blurb{font-size:11px;color:var(--ink-dim);margin-left:6px}

  .grid{display:grid;grid-template-columns:1fr 262px;gap:12px}
  @media(max-width:920px){.grid{grid-template-columns:1fr}}
  .stage{position:relative;background:var(--panel);border:1px solid var(--edge);
         border-radius:9px;overflow:hidden}
  canvas{display:block;width:100%;height:392px;cursor:crosshair}
  .tag{position:absolute;top:10px;left:12px;font-size:11px;letter-spacing:.14em;
       padding:4px 10px;border-radius:5px;border:1px solid var(--edge);background:rgba(8,11,18,.9)}
  .tag.long{color:var(--up);border-color:rgba(63,208,122,.5)}
  .tag.short{color:var(--down);border-color:rgba(242,86,75,.5)}
  .tag.flat{color:var(--flat);border-color:rgba(90,107,133,.5)}
  .stepper{position:absolute;top:10px;right:12px;font-size:12px;color:var(--amber);
           background:rgba(8,11,18,.9);border:1px solid var(--edge);border-radius:5px;padding:4px 10px}
  .ohlc{position:absolute;top:44px;left:12px;display:none;pointer-events:none;
        background:rgba(8,11,18,.94);border:1px solid var(--edge);border-radius:6px;
        padding:7px 10px;font-size:11px;line-height:1.6;white-space:nowrap;
        font-variant-numeric:tabular-nums}
  .ohlc.show{display:block}
  .ohlc .d{color:var(--amber);margin-bottom:3px}
  .ohlc span{color:var(--ink-dim)}
  .alert{position:absolute;left:50%;transform:translateX(-50%);bottom:12px;display:none;
         background:rgba(240,168,46,.14);border:1px solid var(--amber);border-radius:7px;
         padding:7px 16px;font-size:12px;color:var(--amber);letter-spacing:.06em}
  .alert.show{display:block}

  .side{display:flex;flex-direction:column;gap:8px}
  .card{background:var(--panel);border:1px solid var(--edge);border-radius:8px;padding:10px 11px}
  .card h3{margin:0 0 7px;font-size:9px;letter-spacing:.16em;color:var(--amber);
           text-transform:uppercase;font-weight:600}
  .row{display:flex;justify-content:space-between;gap:8px;font-size:12px;padding:2px 0;
       font-variant-numeric:tabular-nums}
  .row span:first-child{color:var(--ink-dim)}
  .row b{font-weight:600}
  .up{color:var(--up)} .down{color:var(--down)} .amber{color:var(--amber)} .flat{color:var(--flat)}
  .big{font-size:19px;font-variant-numeric:tabular-nums}

  .acts{display:grid;grid-template-columns:1fr 1fr;gap:6px}
  .acts .wide{grid-column:1/-1}
  button{
    font-family:inherit;font-size:11.5px;letter-spacing:.05em;cursor:pointer;
    background:var(--panel2);color:var(--ink);border:1px solid var(--edge);
    border-radius:7px;padding:10px 6px;text-align:center;
  }
  button:hover:not(:disabled){border-color:var(--amber-dim);color:var(--amber)}
  button:disabled{opacity:.26;cursor:not-allowed}
  button:focus-visible{outline:2px solid var(--amber);outline-offset:2px}
  #bBuy{background:rgba(63,208,122,.16);border-color:rgba(63,208,122,.5);color:#7DE3A4}
  #bBuy:hover:not(:disabled){background:rgba(63,208,122,.3);color:#C8FADB}
  #bShort{background:rgba(242,86,75,.16);border-color:rgba(242,86,75,.5);color:#FF9C94}
  #bShort:hover:not(:disabled){background:rgba(242,86,75,.3);color:#FFD3CF}
  #bStep{background:var(--panel2)}
  #bDec{background:var(--blue);border-color:var(--blue);color:#04122E;font-weight:700}
  #bDec:hover:not(:disabled){background:#6BA2FF;color:#04122E}
  .speeds{display:flex;gap:4px;margin-top:6px}
  .speeds button{flex:1;padding:7px 0;font-size:11px}
  .speeds button.on{background:var(--amber);color:#1A1204;border-color:var(--amber);font-weight:700}
  .feed{font-size:11px;color:var(--ink-dim);margin-top:8px;min-height:32px;line-height:1.5}
  .feed b{color:var(--ink)}

  .over{position:absolute;inset:0;background:rgba(8,11,18,.97);display:none;
        flex-direction:column;align-items:center;justify-content:flex-start;padding:18px;overflow:auto}
  .over.show{display:flex}
  .over h2{margin:0 0 4px;font-size:22px;letter-spacing:.05em;text-align:center}
  .over .when{font-size:11px;color:var(--ink-dim);margin-bottom:10px}
  table{border-collapse:collapse;font-size:11.5px;min-width:340px}
  th{text-align:left;font-size:9px;letter-spacing:.14em;color:var(--amber);
     text-transform:uppercase;padding:7px 8px 3px;font-weight:600}
  td{padding:3px 8px;border-bottom:1px solid var(--edge);font-variant-numeric:tabular-nums}
  td:last-child{text-align:right}
  .over .btns{display:flex;gap:8px;margin-top:14px}
  .over .btns button{min-width:150px;background:var(--amber);color:#1A1204;
                     border-color:var(--amber);font-weight:700}
  .over .btns button.ghost{background:transparent;color:var(--ink);border-color:var(--edge);font-weight:400}
  .setupbox{max-width:620px;text-align:center}
  .setupbox h3{margin:0 0 4px;font-size:15px;color:var(--amber);letter-spacing:.1em}
  .setupbox p{font-size:12px;color:var(--ink-dim);line-height:1.6;margin:0 0 16px}
  .field{display:flex;gap:8px;align-items:center;justify-content:center;
         margin-bottom:10px;flex-wrap:wrap}
  .field label{font-size:10px;letter-spacing:.13em;color:var(--ink-dim);
               text-transform:uppercase;min-width:96px;text-align:right}
  input[type=date],select{font-family:inherit;font-size:12px;background:var(--panel2);
    color:var(--ink);border:1px solid var(--edge);border-radius:6px;padding:8px 10px}
  input[type=date]:focus,select:focus{outline:2px solid var(--amber);outline-offset:1px}
  .years{display:flex;gap:5px;flex-wrap:wrap;justify-content:center;margin:2px 0 14px}
  .years button{padding:6px 11px;font-size:11px}
  .log{max-height:240px;overflow:auto;font-size:11px;min-width:520px;
       border:1px solid var(--edge);border-radius:7px}
  .log td{white-space:nowrap}
  .log tr.clickable{cursor:pointer}
  .log tr.clickable:hover td{background:rgba(240,168,46,.1)}
  .tabs{display:flex;gap:6px;margin-bottom:10px}
  .tb{font-size:10px;letter-spacing:.12em;padding:7px 14px}
  .tb.on{background:var(--amber);color:#1A1204;border-color:var(--amber);font-weight:700}
  .scg{display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));
       gap:6px;margin-bottom:12px;width:100%;max-width:760px}
  .sc{background:var(--panel);border:1px solid var(--edge);border-radius:6px;padding:6px 8px}
  .sc .k{font-size:8.5px;letter-spacing:.11em;color:var(--ink-dim);text-transform:uppercase}
  .sc .v{font-size:13px;margin-top:2px;font-variant-numeric:tabular-nums}
  .hintline{font-size:10.5px;color:var(--ink-dim);margin-top:7px}
  .tradechart,.equitychart{background:var(--panel);border:1px solid var(--edge);
       border-radius:8px;padding:8px;margin-bottom:12px}
  .tradechart canvas,.equitychart canvas{display:block;max-width:100%;height:auto}
  .eclegend{font-size:10px;color:var(--ink-dim);margin-top:5px;text-align:center}
  .eclegend .k1{color:#3FD07A} .eclegend .k2{color:rgba(232,228,217,.6)}
  .cols{display:flex;gap:14px;flex-wrap:wrap;justify-content:center}
  .cols table{min-width:290px}
</style>

<div class="shell">
  <div class="top">
    <h1>BEAT THE HOLD</h1>
    <span class="sub">NQ FUTURES · 2004&ndash;2026 · REAL HISTORY · NO REWIND</span>
    <a class="back" href="/">&larr; back to terminal</a>
  </div>
  <div class="chips" id="chips"></div>
  <div class="setup" id="setup"></div>

  <div class="grid">
    <div class="stage">
      <canvas id="c"></canvas>
      <div class="ohlc" id="ohlc"></div>
      <div class="tag flat" id="tag">FLAT</div>
      <div class="stepper" id="stepper">BAR 1 / 200</div>
      <div class="alert" id="alert"></div>
      <div class="over" id="over"></div>
    </div>

    <div class="side">
      <div class="card">
        <h3>Market</h3>
        <div class="row"><span>Date</span><b id="mDate">—</b></div>
        <div class="row"><span>Price</span><b class="big amber" id="mPrice">—</b></div>
        <div class="row"><span>Decision</span><b id="mDec">1</b></div>
      </div>

      <div class="card">
        <h3>Your account</h3>
        <div class="row"><span>Cash</span><b id="aCash">—</b></div>
        <div class="row"><span>Position</span><b id="aPos">FLAT</b></div>
        <div class="row"><span>Entry</span><b id="aEntry">—</b></div>
        <div class="row"><span>Unrealised</span><b id="aUnreal">—</b></div>
        <div class="row"><span>Realised</span><b id="aReal">—</b></div>
        <div class="row"><span>Equity</span><b class="big" id="aEquity">—</b></div>
        <div class="row"><span>Max drawdown</span><b id="aDd">0.0%</b></div>
        <div class="row"><span>Trades</span><b id="aTrades">0</b></div>
      </div>

      <div class="card">
        <h3>Benchmark</h3>
        <div class="row"><span>Buy &amp; hold</span><b id="bEquity">—</b></div>
        <div class="row"><span>You vs hold</span><b class="big" id="bEdge">—</b></div>
      </div>

      <div class="card">
        <h3>Trade</h3>
        <div class="acts">
          <button id="bBuy">BUY LONG</button>
          <button id="bShort">SHORT</button>
          <button id="bClose" class="wide">CLOSE</button>
        </div>
      </div>

      <div class="card">
        <h3>Move the market</h3>
        <div class="acts">
          <button id="bStep">NEXT STEP</button>
          <button id="bDec">NEXT DECISION</button>
        </div>
        <div class="speeds">
          <button data-sp="1">1x</button>
          <button data-sp="2">2x</button>
          <button data-sp="5">5x</button>
          <button data-sp="10">10x</button>
          <button id="bPause">PAUSE</button>
        </div>
        <div class="feed" id="feed">Position stays as it is unless you change it.</div>
      </div>

      <div class="card">
        <button id="bJournal" style="width:100%">TRADING JOURNAL</button>
      </div>
    </div>
  </div>
</div>

<script>
const GAME =
